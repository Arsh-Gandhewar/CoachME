# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/trainersapp

# JWT (REQUIRED in production — server will refuse to start without these)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Razorpay (REQUIRED in production)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_TRAINER_PLAN_ID=your_razorpay_trainer_plan_id

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase
FIREBASE_SERVICE_ACCOUNT=path_to_service_account.json

# Email (SMTP)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
