# CoachME Client Environment Variables
# Copy this file to .env and fill in the values

# API Server URL (REQUIRED for mobile — must be your server's URL)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Socket.io Server URL (REQUIRED for mobile — must match API server host)
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Razorpay (REQUIRED for payments)
EXPO_PUBLIC_RAZORPAY_KEY=your_razorpay_key_id
